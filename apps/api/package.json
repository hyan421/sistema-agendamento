{
  "name": "@navalha/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "node --eval \"console.error('Seed ainda nao foi implementado (lote 2).'); process.exit(1)\""
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
